#!/bin/sh
# Sintoniza Import: the main app started as the import program (--import). Sintoniza Emi.app is looked for next to this app (both in Applications),
# then in the user's Applications; also under its name before (Sintoniza Radio Broadcast system.app).
here="$(cd "$(dirname "$0")/../../.." && pwd)"
for app in "$here/Sintoniza Emi.app" "/Applications/Sintoniza Emi.app" "$HOME/Applications/Sintoniza Emi.app" \
           "$here/Sintoniza Radio Broadcast system.app" "/Applications/Sintoniza Radio Broadcast system.app" \
           "$HOME/Applications/Sintoniza Radio Broadcast system.app"; do
  for exe in SintonizaEmi RadioPlayout; do
    if [ -x "$app/Contents/MacOS/$exe" ]; then exec "$app/Contents/MacOS/$exe" --import "$@"; fi
  done
done
osascript -e 'display alert "Sintoniza Import" message "Put Sintoniza Import in the same folder as Sintoniza Emi (Applications)."'
exit 1
