#!/bin/sh
# Sintoniza Tempo: the studio clock, inside Sintoniza Emi.app (SintonizaTempo). Sintoniza Emi.app is looked for next to this app (both in Applications),
# then in the user's Applications; also under its name before (Sintoniza Radio Broadcast system.app).
here="$(cd "$(dirname "$0")/../../.." && pwd)"
for app in "$here/Sintoniza Emi.app" "/Applications/Sintoniza Emi.app" "$HOME/Applications/Sintoniza Emi.app" \
           "$here/Sintoniza Radio Broadcast system.app" "/Applications/Sintoniza Radio Broadcast system.app" \
           "$HOME/Applications/Sintoniza Radio Broadcast system.app"; do
  for exe in SintonizaTempo; do
    if [ -x "$app/Contents/MacOS/$exe" ]; then exec "$app/Contents/MacOS/$exe" "$@"; fi
  done
done
osascript -e 'display alert "Sintoniza Tempo" message "Put Sintoniza Tempo in the same folder as Sintoniza Emi (Applications)."'
exit 1
