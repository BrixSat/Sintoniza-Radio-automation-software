<Project Sdk="Microsoft.NET.Sdk">
  <!-- Sintoniza Pro: its own program (process, executable, icon): the station's settings, categories, cartwalls, schedule, hour templates and daily playlists of Playout.App. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>..\Playout.App\app.manifest</ApplicationManifest>
    <AssemblyName>SintonizaPro</AssemblyName>
    <RootNamespace>Sintoniza.Pro</RootNamespace>
    <ApplicationIcon>..\Playout.App\Assets\schedule.ico</ApplicationIcon>
    <!-- build.sh sets the real version. -->
    <Version>0.0.0</Version>
    <Product>Sintoniza</Product>
    <AssemblyTitle>Sintoniza Pro</AssemblyTitle>
    <Company>César Araújo</Company>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Playout.App\Playout.App.csproj" />
  </ItemGroup>
  <Import Project="..\Bass.targets" />
</Project>
