<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Playout.App.DownloadsView">
    <UserControl.Styles>
        <Style Selector="TextBlock.note">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Classes="note" MaxWidth="900" HorizontalAlignment="Left"
                       Text="Files fetched again and again, such as the news bulletin an agency puts on its website every hour: always saved under the same name, so the playlists and events that play that file get the latest. The computer on air fetches them (never a standby one); a file not fetched for its too-old time is passed over on air, and an alert says so." />
        </StackPanel>
        <WrapPanel DockPanel.Dock="Bottom" ItemSpacing="8" LineSpacing="8" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Content="Save" Classes="accent" />
            <Button x:Name="UndoButton" Content="Undo changes" />
            <TextBlock x:Name="StatusText" Classes="note" VerticalAlignment="Center" MaxWidth="700" />
        </WrapPanel>
        <Grid ColumnDefinitions="280,16,*">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button x:Name="AddButton" Content="Add" />
                    <Button x:Name="RemoveButton" Content="Remove" />
                </StackPanel>
                <ListBox x:Name="List" />
            </DockPanel>
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Editor" Spacing="12" Margin="0,0,16,0" MaxWidth="760" HorizontalAlignment="Left">
                    <CheckBox x:Name="EnabledBox" Content="Fetch it" FontWeight="SemiBold" />
                    <StackPanel>
                        <TextBlock Classes="label" Text="Name" />
                        <TextBox x:Name="NameBox" PlaceholderText="News" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Classes="label" Text="From" />
                        <ComboBox x:Name="SourceBox" MinWidth="320">
                            <ComboBoxItem Content="A page with a link to the file (the first one that matches)" />
                            <ComboBoxItem Content="The file's own address" />
                            <ComboBoxItem Content="An FTP server" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="AddressLabel" Classes="label" Text="Address" />
                        <TextBox x:Name="AddressBox" PlaceholderText="https://www.example.com/news" />
                    </StackPanel>
                    <StackPanel x:Name="PatternPanel">
                        <TextBlock Classes="label" Text="The link to take: the first on the page that matches (a regular expression)" />
                        <TextBox x:Name="PatternBox" FontFamily="monospace" />
                        <TextBlock Classes="note" Margin="0,4,0,0"
                                   Text="As it is: the first address on the page that ends in .mp3. Test shows what it finds." />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel>
                            <TextBlock Classes="label" Text="User (if it asks for one)" />
                            <TextBox x:Name="UserBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Classes="label" Text="Password" />
                            <TextBox x:Name="PasswordBox" PasswordChar="•" />
                        </StackPanel>
                    </Grid>
                    <StackPanel>
                        <TextBlock Classes="label" Text="Saved as (a file the studios reach: put this file in the playlists and events)" />
                        <DockPanel>
                            <Button x:Name="SaveAsButton" DockPanel.Dock="Right" Content="Choose…" Margin="8,0,0,0" />
                            <TextBox x:Name="SaveAsBox" PlaceholderText="/music/news/news.mp3" />
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="When" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <RadioButton x:Name="EveryRadio" GroupName="When" Content="Every" VerticalAlignment="Center" />
                            <NumericUpDown x:Name="EveryBox" Minimum="1" Maximum="1440" Increment="5" FormatString="0" Width="120" />
                            <TextBlock Text="minutes" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <RadioButton x:Name="AtRadio" GroupName="When" Content="At these minutes past each hour:" VerticalAlignment="Center" />
                            <TextBox x:Name="AtBox" Width="160" PlaceholderText="2, 32" />
                        </StackPanel>
                        <TextBlock Classes="note" Text="Fetch it a little after the source puts a new one up. A fetch that fails is tried again every 2 minutes; the same file again only counts as fresh." />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel>
                            <TextBlock Classes="label" Text="Too old after (minutes; 0: never)" />
                            <NumericUpDown x:Name="TooOldBox" Minimum="0" Maximum="10080" Increment="15" FormatString="0" Width="140" HorizontalAlignment="Left" />
                            <TextBlock Classes="note" Margin="0,4,0,0" Text="Not fetched for this long: passed over on air (no yesterday's news), and an alert." />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Classes="label" Text="Shortest it may be (seconds)" />
                            <NumericUpDown x:Name="ShortestBox" Minimum="0" Maximum="3600" Increment="5" FormatString="0" Width="140" HorizontalAlignment="Left" />
                            <TextBlock Classes="note" Margin="0,4,0,0" Text="Shorter: not taken (an error page, a file cut short); the one before stays." />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="TestButton" Content="Test" />
                        <TextBlock x:Name="TestText" Classes="note" VerticalAlignment="Center" MaxWidth="600" />
                    </StackPanel>
                    <TextBlock x:Name="FileText" Classes="note" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
