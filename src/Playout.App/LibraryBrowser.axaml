<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Playout.App"
             x:Class="Playout.App.LibraryBrowser">

    <Grid RowDefinitions="Auto,*,Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto,Auto" Margin="4,0,0,8">
            <Button Grid.Column="1" x:Name="RefreshButton" Classes="tool" Margin="0,0,6,0"
                    ToolTip.Tip="Re-read the folders and files from disk">
                <PathIcon Width="13" Height="13"
                          Data="M8,1 A7,7 0 1 0 15,8 H13 A5,5 0 1 1 8,3 V6 L12,2 L8,-2 Z" />
            </Button>
            <Button Grid.Column="2" x:Name="ChooseRootButton" Classes="tool" Content="Folder…"
                    ToolTip.Tip="Choose the music root folder" />
        </Grid>

        <TreeView Grid.Row="1" x:Name="FolderTree" Background="Transparent">
            <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="app:FolderNode">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="MinHeight" Value="26" />
                </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="app:FolderNode" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Width="13" Height="13" Opacity="0.7"
                                  Data="M0,2 C0,1 1,0 2,0 H6 L8,2 H14 C15,2 16,3 16,4 V12 C16,13 15,14 14,14 H2 C1,14 0,13 0,12 Z" />
                        <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <GridSplitter Grid.Row="2" Height="6" Background="Transparent" ResizeDirection="Rows" />

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,2,0,6">
            <TextBox x:Name="FilterBox" PlaceholderText="Filter files…" FontSize="12" />
            <TextBlock Grid.Column="1" x:Name="FileCount" Classes="muted" FontSize="11" Margin="8,0,2,0" VerticalAlignment="Center" />
        </Grid>

        <ListBox Grid.Row="4" x:Name="FileList" SelectionMode="Multiple" Background="Transparent">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="8,4" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="CornerRadius" Value="4" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="app:FileEntry">
                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
