<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Playout.App.PauseDialog"
        Icon="/Assets/icon.ico"
        Title="Add pause"
        Width="480" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="18" Spacing="14">
        <TextBlock Classes="note" FontSize="12"
                   Text="No sound for a while, so the presenter can talk: the next item starts when it ends." />
        <StackPanel>
            <TextBlock Classes="label" Text="What to talk about" />
            <TextBox x:Name="CommentBox" PlaceholderText="e.g. Weather and traffic" />
            <TextBlock Classes="note" Margin="0,4,0,0"
                       Text="Shown as its title in the playlist and on air, and in the notes when it is next. It never goes out on RDS or the stream." />
        </StackPanel>
        <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="How long" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <RadioButton x:Name="ForRadio" GroupName="Length" Content="For" VerticalAlignment="Center" IsChecked="True" />
                <TextBox x:Name="LengthBox" Width="110" Text="1:00" PlaceholderText="1:00" />
                <TextBlock Classes="note" Text="minutes:seconds" VerticalAlignment="Center" />
            </StackPanel>
            <RadioButton x:Name="UntilNextRadio" GroupName="Length" Content="Until I press Next" />
        </StackPanel>
        <CheckBox x:Name="PlayNextBox" Content="Play next (right after the item on air)" IsChecked="True" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource OnAir}" FontSize="12" IsVisible="False" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" HorizontalContentAlignment="Center" IsCancel="True" />
            <Button x:Name="AddButton" Content="Add" MinWidth="90" HorizontalContentAlignment="Center" IsDefault="True" Classes="accent" />
        </StackPanel>
    </StackPanel>
</Window>
