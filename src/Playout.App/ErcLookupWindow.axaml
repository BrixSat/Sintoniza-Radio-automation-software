<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Playout.App.ErcLookupWindow"
        Icon="/Assets/schedule.ico"
        Title="Look up on MusicBrainz"
        Width="760" Height="620" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="TextBlock.note">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
            <TextBlock x:Name="HeadText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Classes="note"
                       Text="Each song is looked for on MusicBrainz (musicbrainz.org, the free music encyclopedia): the performer's country, the language of the lyrics and the first edition. Portuguese music is suggested when it is sung in Portuguese, or by a Portuguese performer. Untick what isn't right; only what is ticked is saved, and nothing it doesn't know is changed." />
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                <ProgressBar x:Name="Progress" Height="6" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="ProgressText" Classes="note" Margin="10,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource OnAir}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="StopButton" Content="Stop" MinWidth="90" HorizontalContentAlignment="Center" />
                <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" HorizontalContentAlignment="Center" IsCancel="True" />
                <Button x:Name="SaveButton" Content="Save the ticked" MinWidth="90" HorizontalContentAlignment="Center" Classes="accent" IsEnabled="False" />
            </StackPanel>
        </Grid>
        <ScrollViewer Background="#13161C">
            <StackPanel x:Name="RowsPanel" Spacing="1" />
        </ScrollViewer>
    </DockPanel>
</Window>
