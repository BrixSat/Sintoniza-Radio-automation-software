<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:Playout.App"
        x:Class="Playout.App.SettingsWindow"
        Icon="/Assets/icon.ico"
        Title="Settings"
        Width="680" Height="580" CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" HorizontalContentAlignment="Center" IsCancel="True" />
            <Button x:Name="SaveButton" Content="Save" MinWidth="90" HorizontalContentAlignment="Center" IsDefault="True"
                    Classes="accent" />
        </StackPanel>

        <TabControl>
            <!-- ───────── Station ───────── -->
            <TabItem Header="Station">
                <StackPanel Spacing="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Classes="label" Text="Station name" />
                        <TextBox x:Name="StationNameBox" PlaceholderText="e.g. Rádio Exemplo 99.9 FM" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Classes="label" Text="Logo" />
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Width="96" Height="96" CornerRadius="10" Background="#13161C" ClipToBounds="True"
                                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                                <Panel>
                                    <Image x:Name="LogoPreview" Stretch="Uniform" />
                                    <TextBlock x:Name="NoLogoText" Text="No logo" Classes="note" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Panel>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="8" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ChooseLogoButton" Content="Choose image…" />
                                    <Button x:Name="RemoveLogoButton" Content="Remove" />
                                </StackPanel>
                                <TextBlock Classes="note" Text="PNG, JPG, BMP or WebP. A square image looks best; it is shown next to the clock." />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel>
                            <TextBlock Classes="label" Text="Genre" />
                            <TextBox x:Name="GenreBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Classes="label" Text="Website" />
                            <TextBox x:Name="UrlBox" PlaceholderText="https://" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Classes="note" Text="Name, genre and website are also sent to the streaming server and shown in directory listings." />

                    <StackPanel>
                        <TextBlock Classes="label" Text="Station type" />
                        <ComboBox x:Name="StationTypeBox" MinWidth="320">
                            <ComboBoxItem Content="FM radio (mic through the mixing desk)" />
                            <ComboBoxItem Content="Web radio (mic through this computer)" />
                        </ComboBox>
                        <TextBlock Classes="note" Margin="0,4,0,0"
                                   Text="Web radio adds a MIC button: hold it to talk. Set up the microphone on the Microphone tab." />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- ───────── Audio ───────── -->
            <TabItem Header="Audio">
                <StackPanel Spacing="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Classes="label" Text="Crossfade between tracks (seconds)" />
                        <NumericUpDown x:Name="CrossfadeBox" Minimum="0" Maximum="15" Increment="0.5" FormatString="0.0"
                                       Width="160" HorizontalAlignment="Left" />
                        <TextBlock Classes="note" Margin="0,4,0,0"
                                   Text="The outgoing track fades out over this time while the next one starts. 0 = back-to-back. Applies from the next track." />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Classes="label" Text="Outputs (one desk channel each)" />
                        <Grid ColumnDefinitions="90,*,10,110,10,Auto" RowDefinitions="Auto,8,Auto,8,Auto">
                            <TextBlock Text="Music" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ComboBox Grid.Column="1" x:Name="MusicDeviceBox" HorizontalAlignment="Stretch" />
                            <ComboBox Grid.Column="3" x:Name="MusicChannelBox" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="5" x:Name="MusicTestButton" Content="Test" ToolTip.Tip="1 second 1 kHz tone on this output" />

                            <TextBlock Grid.Row="2" Text="Cartwall" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CartDeviceBox" HorizontalAlignment="Stretch" />
                            <ComboBox Grid.Row="2" Grid.Column="3" x:Name="CartChannelBox" HorizontalAlignment="Stretch" />
                            <Button Grid.Row="2" Grid.Column="5" x:Name="CartTestButton" Content="Test" ToolTip.Tip="1 second 1 kHz tone on this output" />

                            <TextBlock Grid.Row="4" Text="Preview" VerticalAlignment="Center" FontWeight="SemiBold"
                                       ToolTip.Tip="Pre-listen in the cue editor. Use an output that is not on air, e.g. the desk's PFL / cue input or headphones." />
                            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="PreviewDeviceBox" HorizontalAlignment="Stretch" />
                            <ComboBox Grid.Row="4" Grid.Column="3" x:Name="PreviewChannelBox" HorizontalAlignment="Stretch" />
                            <Button Grid.Row="4" Grid.Column="5" x:Name="PreviewTestButton" Content="Test" ToolTip.Tip="1 second 1 kHz tone on this output" />
                        </Grid>
                        <TextBlock Classes="note" Margin="0,6,0,0"
                                   Text="Send music and cartwall to different sound cards or output pairs to get them on separate desk faders. Use Test to find which fader is which. Applies when you click Save. The stream always carries music and cartwall together. Preview (for the cue editor) is never streamed; give it an output that is not on air." />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- ───────── Microphone ───────── -->
            <TabItem Header="Microphone">
                <StackPanel Spacing="14" Margin="0,12,0,0">
                    <TextBlock x:Name="MicFmNote" Classes="note"
                               Text="The station type is FM radio, so the mic goes through the mixing desk and these settings are not used. Choose Web radio on the Station tab to use them." />
                    <StackPanel x:Name="MicPanel" Spacing="14">
                        <StackPanel>
                            <TextBlock Classes="label" Text="Microphone input" />
                            <ComboBox x:Name="MicDeviceBox" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel>
                                <TextBlock Classes="label" Text="Mic level (dB)" />
                                <NumericUpDown x:Name="MicGainBox" Minimum="-20" Maximum="20" Increment="1" FormatString="+0;-0;0"
                                               HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="label" Text="Music level while talking (dB)" />
                                <NumericUpDown x:Name="DuckBox" Minimum="-60" Maximum="0" Increment="1" FormatString="0"
                                               HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel>
                                <TextBlock Classes="label" Text="Fade down (seconds)" />
                                <NumericUpDown x:Name="FadeDownBox" Minimum="0" Maximum="5" Increment="0.1" FormatString="0.0"
                                               HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="label" Text="Fade back up (seconds)" />
                                <NumericUpDown x:Name="FadeUpBox" Minimum="0" Maximum="5" Increment="0.1" FormatString="0.0"
                                               HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Classes="note"
                                   Text="Hold the MIC button or its key (F9 unless changed on the Shortcuts tab) to talk. Music and cartwall fade down to the level above, and back up when you let go. The mic goes into the stream only, not to the audio outputs, so you don't hear yourself with a delay; listen on headphones." />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- ───────── Time signal ───────── -->
            <TabItem Header="Time signal">
                <StackPanel Spacing="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Classes="label" Text="At the top of the hour" />
                        <ComboBox x:Name="TimeSignalModeBox" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Off: no time signal" />
                            <ComboBoxItem Content="Play it over what is playing" />
                            <ComboBoxItem Content="Stop what is playing, play it, then carry on with the next item" />
                        </ComboBox>
                        <TextBlock Classes="note" Margin="0,4,0,0"
                                   Text="With Stop, the item on air and any carts fade out just before the time signal. Right after it the next playlist item starts in AUTO; otherwise the player waits for you. If nothing is playing, the time signal plays on its own." />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="Sound" />
                        <RadioButton x:Name="PipsRadio" GroupName="Signal" Content="Pips: five short and a long one, the long one starts on the hour" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <RadioButton x:Name="SignalFileRadio" GroupName="Signal" Content="Audio file:" VerticalAlignment="Center" />
                            <TextBlock x:Name="SignalFileText" VerticalAlignment="Center" MaxWidth="300" TextTrimming="CharacterEllipsis" />
                            <Button x:Name="ChooseSignalButton" Content="Choose…" />
                        </StackPanel>
                        <TextBlock Classes="note" Text="An audio file is started so that it ends exactly on the hour." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="ListenSignalButton" Content="Listen" ToolTip.Tip="Play the time signal now on the Preview output (not on air)" />
                        <TextBlock Classes="note" VerticalAlignment="Center" Text="Plays it now on the Preview output, not on air." />
                    </StackPanel>
                    <TextBlock Classes="note"
                               Text="The time signal comes out of the Cartwall output and goes into the stream. It follows this computer's clock, so keep the clock set automatically (internet time)." />
                </StackPanel>
            </TabItem>

            <!-- ───────── Shortcuts ───────── -->
            <TabItem Header="Shortcuts">
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <TextBlock Classes="note"
                               Text="Click a box, then press the key or combination, e.g. F5, Space, Ctrl+1 or Num 1. Backspace or Delete clears it, Esc cancels. Cart keys play or stop the carts of the cartwall on screen." />
                    <Grid ColumnDefinitions="4*,16,3*,16,3*">
                        <StackPanel x:Name="PlayerKeys" Spacing="6" />
                        <StackPanel Grid.Column="2" x:Name="CartKeysA" Spacing="6" />
                        <StackPanel Grid.Column="4" x:Name="CartKeysB" Spacing="6" />
                    </Grid>
                    <TextBlock x:Name="ShortcutMessage" Classes="note" Foreground="{StaticResource NextUp}" />
                    <Button x:Name="DefaultKeysButton" Content="Reset to defaults" />
                    <TextBlock Classes="note"
                               Text="Plain keys (letters, numbers, Space) don't fire while you type in a text box, such as the music folder filter; F-keys and Ctrl/Alt combinations always do." />
                </StackPanel>
            </TabItem>

            <!-- ───────── Streaming ───────── -->
            <TabItem Header="Streaming">
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Classes="label" Text="Server type" />
                        <ComboBox x:Name="ServerTypeBox" MinWidth="220" SelectedIndex="0">
                            <ComboBoxItem Content="Icecast 2" />
                            <ComboBoxItem Content="Shoutcast v1" />
                        </ComboBox>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,12,120">
                        <StackPanel>
                            <TextBlock Classes="label" Text="Server host" />
                            <TextBox x:Name="HostBox" PlaceholderText="stream.example.com" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Classes="label" Text="Port" />
                            <TextBox x:Name="PortBox" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel x:Name="MountPanel">
                            <TextBlock Classes="label" Text="Mount point" />
                            <TextBox x:Name="MountBox" PlaceholderText="/live" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Classes="label" Text="Source password" />
                            <TextBox x:Name="PasswordBox" PasswordChar="•" RevealPassword="False" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel>
                            <TextBlock Classes="label" Text="Format" />
                            <ComboBox x:Name="FormatBox" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="MP3" />
                                <ComboBoxItem Content="OGG Vorbis" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Classes="label" Text="Bitrate (kbps)" />
                            <ComboBox x:Name="BitrateBox" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="64" />
                                <ComboBoxItem Content="96" />
                                <ComboBoxItem Content="128" />
                                <ComboBoxItem Content="192" />
                                <ComboBoxItem Content="256" />
                                <ComboBoxItem Content="320" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <TextBlock Classes="note" Text="Start and stop the stream with the STREAM button next to ON AIR. Changes here apply the next time the stream starts." />
                </StackPanel>
            </TabItem>
            <!-- ───────── About ───────── -->
            <TabItem Header="About">
                <StackPanel Spacing="14" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Image Source="/Assets/icon.ico" Width="56" Height="56" />
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Static app:AppInfo.Name}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionText" Classes="note" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="By César Araújo" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="WebsiteButton" Content="cesararaujo.net" Classes="tool" />
                            <Button x:Name="SourceButton" Content="Source and releases on GitHub" Classes="tool" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Classes="label" Text="Updates" />
                        <CheckBox x:Name="AutoUpdateBox" Content="Check for new versions automatically (at start and every 6 hours)" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="CheckNowButton" Content="Check now" />
                            <TextBlock x:Name="UpdateResultText" Classes="note" VerticalAlignment="Center" />
                            <Button x:Name="ShowUpdateButton" Content="Details and install…" Classes="accent" IsVisible="False" />
                        </StackPanel>
                        <TextBlock Classes="note"
                                   Text="A new version is never installed by itself: you choose when. Installed with the setup (Windows) or the .deb package (Linux), it downloads and installs in one click; other copies open the download page." />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
