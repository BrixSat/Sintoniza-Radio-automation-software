<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Playout.App.ErcSongWindow"
        Icon="/Assets/schedule.ico"
        Title="ERC classification"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>
    <StackPanel Margin="20" Spacing="14">
        <TextBlock x:Name="SongsText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <StackPanel>
            <TextBlock Classes="label" Text="Portuguese music (Lei da Rádio, art. 41.º)" />
            <ComboBox x:Name="PortugueseBox" HorizontalAlignment="Stretch" />
        </StackPanel>
        <StackPanel>
            <TextBlock Classes="label" Text="Language it is sung in" />
            <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch" />
        </StackPanel>
        <StackPanel>
            <TextBlock Classes="label" Text="Performer's country" />
            <ComboBox x:Name="CountryBox" HorizontalAlignment="Stretch" />
        </StackPanel>
        <StackPanel>
            <TextBlock Classes="label" Text="First edition" />
            <TextBox x:Name="ReleaseBox" PlaceholderText="yyyy-mm-dd, yyyy-mm or yyyy (empty: the year tag)" />
        </StackPanel>
        <TextBlock Classes="note"
                   Text="&quot;As its category says&quot; takes the defaults of the song's categories (Sintoniza Pro → Categories). Portuguese music in Portuguese by an EU performer counts for the language quota; music first edited in the last 12 months counts as recent." />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource OnAir}" FontSize="12" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" HorizontalContentAlignment="Center" IsCancel="True" />
            <Button x:Name="SaveButton" Content="Save" MinWidth="90" HorizontalContentAlignment="Center" Classes="accent" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
