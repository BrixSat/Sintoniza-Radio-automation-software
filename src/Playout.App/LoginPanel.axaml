<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Playout.App.LoginPanel">
    <StackPanel Spacing="14">
        <Grid ColumnDefinitions="Auto,12,*">
            <Image Source="/Assets/icon.ico" Width="44" Height="44" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Name="ProgramText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="StationText" Classes="muted" FontSize="12" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="ReasonText" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="False" />
        <StackPanel Spacing="4">
            <TextBlock Text="User" Classes="muted" FontSize="12" />
            <TextBox x:Name="UserBox" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="Password" Classes="muted" FontSize="12" />
            <TextBox x:Name="PasswordBox" PasswordChar="•" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource OnAir}" FontSize="12" TextWrapping="Wrap" IsVisible="False" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" HorizontalContentAlignment="Center" />
            <Button x:Name="LoginButton" Content="Log in" MinWidth="90" HorizontalContentAlignment="Center" Classes="accent" />
        </StackPanel>
    </StackPanel>
</UserControl>
