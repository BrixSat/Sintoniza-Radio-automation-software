<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Playout.App.OnlineSettingsWindow"
        Icon="/Assets/online.ico"
        Title="Sintoniza Online — Settings"
        Width="780" Height="640" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>
    <DockPanel Margin="18">
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,14,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource OnAir}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" x:Name="CancelButton" Content="Cancel" MinWidth="90" HorizontalContentAlignment="Center" Margin="8,0,0,0" IsCancel="True" />
            <Button Grid.Column="2" x:Name="SaveButton" Content="Save" MinWidth="90" HorizontalContentAlignment="Center" Margin="8,0,0,0" Classes="accent" />
        </Grid>
        <TabControl>
            <TabItem Header="Source">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14" Margin="0,12,16,0">
                    <StackPanel>
                        <TextBlock Classes="label" Text="Station" />
                        <TextBox x:Name="StationBox" PlaceholderText="Rádio Exemplo 99.9" />
                    </StackPanel>
                    <RadioButton x:Name="InputRadio" GroupName="Source" Content="An input of this computer (the desk's programme output into the sound card)" />
                    <ComboBox x:Name="InputBox" HorizontalAlignment="Stretch" Margin="28,0,0,0" />
                    <RadioButton x:Name="StreamRadio" GroupName="Source" Content="Another stream, relayed (a web address)" />
                    <TextBox x:Name="SourceUrlBox" Margin="28,0,0,0" PlaceholderText="http://studio.example.com:8000/live.mp3" />
                    <StackPanel>
                        <TextBlock Classes="label" Text="Format and quality" />
                        <Grid ColumnDefinitions="*,12,*,12,Auto">
                            <ComboBox x:Name="FormatBox" HorizontalAlignment="Stretch" />
                            <ComboBox Grid.Column="2" x:Name="BitrateBox" HorizontalAlignment="Stretch" />
                            <CheckBox Grid.Column="4" x:Name="MonoBox" Content="Mono" />
                        </Grid>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Classes="label" Text="What the players show: the stream's name (empty: the station's), genre, website and description" />
                        <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,6,Auto">
                            <TextBox x:Name="StreamNameBox" PlaceholderText="(the station's name)" />
                            <TextBox Grid.Column="2" x:Name="GenreBox" PlaceholderText="Pop" />
                            <TextBox Grid.Row="2" x:Name="WebsiteBox" PlaceholderText="https://www.example.com" />
                            <TextBox Grid.Row="2" Grid.Column="2" x:Name="DescriptionBox" PlaceholderText="The best music in town" />
                        </Grid>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Classes="label" Text="Title shown while it plays (empty: none)" />
                        <TextBox x:Name="TitleBox" PlaceholderText="Rádio Exemplo — live" />
                    </StackPanel>
                    <CheckBox x:Name="PublicBox" Content="List the stream in the server's public directory" />
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Server">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14" Margin="0,12,16,0">
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <RadioButton x:Name="IcecastRadio" GroupName="Kind" Content="Icecast" />
                        <RadioButton x:Name="ShoutcastRadio" GroupName="Kind" Content="Shoutcast" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,12,110,12,*">
                        <StackPanel>
                            <TextBlock Classes="label" Text="Server" />
                            <TextBox x:Name="HostBox" PlaceholderText="stream.example.com" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Classes="label" Text="Port" />
                            <NumericUpDown x:Name="PortBox" Minimum="1" Maximum="65535" Increment="1" FormatString="0" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Classes="label" Text="Mount" />
                            <TextBox x:Name="MountBox" PlaceholderText="/live" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel>
                            <TextBlock Classes="label" Text="User" />
                            <TextBox x:Name="UserBox" PlaceholderText="source" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Classes="label" Text="Password" />
                            <TextBox x:Name="PasswordBox" PasswordChar="•" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Classes="note" Text="As the server's administrator gives them: Icecast's source user is usually &quot;source&quot;; Shoutcast has no user or mount. The password is kept only on this computer, in a settings file only you can read." />

                    <CheckBox x:Name="BackupBox" Content="A backup server, for when this one doesn't answer" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <StackPanel x:Name="BackupPanel" Spacing="10" Margin="28,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="18">
                            <RadioButton x:Name="BackupIcecastRadio" GroupName="BackupKind" Content="Icecast" />
                            <RadioButton x:Name="BackupShoutcastRadio" GroupName="BackupKind" Content="Shoutcast" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,12,110,12,*">
                            <TextBox x:Name="BackupHostBox" PlaceholderText="backup.example.com" />
                            <NumericUpDown Grid.Column="2" x:Name="BackupPortBox" Minimum="1" Maximum="65535" Increment="1" FormatString="0" />
                            <TextBox Grid.Column="4" x:Name="BackupMountBox" PlaceholderText="/live" />
                        </Grid>
                        <Grid ColumnDefinitions="*,12,*">
                            <TextBox x:Name="BackupUserBox" PlaceholderText="source" />
                            <TextBox Grid.Column="2" x:Name="BackupPasswordBox" PasswordChar="•" PlaceholderText="password" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Reconnect">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14" Margin="0,12,16,0">
                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                        <TextBlock Text="When the connection fails or drops, try again every" VerticalAlignment="Center" />
                        <NumericUpDown x:Name="RetryBox" Minimum="1" Maximum="3600" Increment="1" FormatString="0" Width="110" />
                        <TextBlock Text="seconds, for as long as it takes" VerticalAlignment="Center" />
                    </WrapPanel>
                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                        <TextBlock Text="Try the backup server after" VerticalAlignment="Center" />
                        <NumericUpDown x:Name="BackupAfterBox" Minimum="1" Maximum="100" Increment="1" FormatString="0" Width="110" />
                        <TextBlock Text="failed attempts in a row" VerticalAlignment="Center" />
                    </WrapPanel>
                    <TextBlock Classes="note" Text="A connection that drops is made again at once, then every so many seconds. On the backup server, the main one is tried every minute, and the stream goes back to it as soon as it answers, with no gap. A server that stops taking the stream for 20 seconds counts as dropped." />
                    <StackPanel>
                        <TextBlock Classes="label" Text="Fallback file: sent (looped) instead of a silent or stopped source; empty: silence" />
                        <Grid ColumnDefinitions="*,8,Auto">
                            <TextBox x:Name="FallbackBox" PlaceholderText="(silence)" />
                            <Button Grid.Column="2" x:Name="FallbackButton" Content="Choose…" />
                        </Grid>
                    </StackPanel>
                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                        <TextBlock Text="after" VerticalAlignment="Center" />
                        <NumericUpDown x:Name="FallbackSecondsBox" Minimum="2" Maximum="3600" Increment="5" FormatString="0" Width="110" />
                        <TextBlock Text="seconds under" VerticalAlignment="Center" />
                        <NumericUpDown x:Name="SilenceDbBox" Minimum="-80" Maximum="-10" Increment="1" FormatString="0" Width="110" />
                        <TextBlock Text="dB, or with no sound from the source" VerticalAlignment="Center" />
                    </WrapPanel>
                    <TextBlock Classes="note" Text="The server never sees the source stop: an input that is unplugged, a stream relayed that drops, or the desk faded down; the listeners stay connected. An input or a stream that stops sending is opened again by itself. A short loop works best (up to 80 MB; it is kept in memory)." />
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Listening">
                <StackPanel Spacing="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Classes="label" Text="Output for listening live" />
                        <ComboBox x:Name="OutputBox" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <TextBlock Classes="note" Text="Headphones or a monitor speaker: never an output that goes on air." />
                </StackPanel>
            </TabItem>
            <TabItem Header="Alerts">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14" Margin="0,12,16,0">
                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                        <TextBlock Text="Off the internet for" VerticalAlignment="Center" />
                        <NumericUpDown x:Name="OfflineAlertBox" Minimum="5" Maximum="3600" Increment="5" FormatString="0" Width="110" />
                        <TextBlock Text="seconds; silence for" VerticalAlignment="Center" />
                        <NumericUpDown x:Name="SilenceSecondsBox" Minimum="5" Maximum="3600" Increment="5" FormatString="0" Width="110" />
                        <TextBlock Text="seconds" VerticalAlignment="Center" />
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox x:Name="AliveBox" Content="&quot;Still online&quot; once a day at" />
                        <NumericUpDown x:Name="AliveHourBox" Minimum="0" Maximum="23" Increment="1" FormatString="00" Width="100" />
                        <TextBlock Text="h (no message one day: something is wrong)" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="note" Text="Alerts: off the internet, on the backup server, no sound from the source, silence, and each one over. Sent wherever is filled in below." />
                    <StackPanel>
                        <TextBlock Classes="label" Text="Telegram: bot token and chat" />
                        <Grid ColumnDefinitions="*,8,*">
                            <TextBox x:Name="TelegramTokenBox" PlaceholderText="123456:ABC…" />
                            <TextBox Grid.Column="2" x:Name="TelegramChatBox" PlaceholderText="-100123…" />
                        </Grid>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Classes="label" Text="E-mail: server, port, user, password, from, to (several: separated by commas)" />
                        <Grid ColumnDefinitions="*,8,90,8,Auto" RowDefinitions="Auto,6,Auto,6,Auto">
                            <TextBox x:Name="SmtpServerBox" PlaceholderText="smtp.example.com" />
                            <NumericUpDown Grid.Column="2" x:Name="SmtpPortBox" Minimum="1" Maximum="65535" FormatString="0" />
                            <CheckBox Grid.Column="4" x:Name="SmtpSslBox" Content="SSL" />
                            <TextBox Grid.Row="2" x:Name="SmtpUserBox" PlaceholderText="user" />
                            <TextBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" x:Name="SmtpPasswordBox" PasswordChar="•" PlaceholderText="password" />
                            <TextBox Grid.Row="4" x:Name="MailFromBox" PlaceholderText="from@example.com" />
                            <TextBox Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3" x:Name="MailToBox" PlaceholderText="to@example.com" />
                        </Grid>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Classes="label" Text="A web address (JSON POST)" />
                        <TextBox x:Name="WebhookBox" PlaceholderText="https://…" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="TestAlertButton" Content="Send a test" />
                        <TextBlock x:Name="TestAlertText" Classes="note" VerticalAlignment="Center" MaxWidth="480" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Security">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14" Margin="0,12,16,0">
                    <CheckBox x:Name="StartOnlineBox" Content="Go online by itself when Sintoniza Online opens" />
                    <CheckBox x:Name="AutostartBox" Content="Start Sintoniza Online when I log in to this computer" />
                    <TextBlock Classes="note" Text="Both together: after a power cut or a restart, the station is back on the internet with nobody there." />
                    <CheckBox x:Name="LockBox" Content="Ask for a password to stop streaming, change the settings or close" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <StackPanel x:Name="LockPanel" Spacing="10" Margin="28,0,0,0">
                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel>
                                <TextBlock Classes="label" Text="New password" />
                                <TextBox x:Name="LockPasswordBox" PasswordChar="•" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="label" Text="Once more" />
                                <TextBox x:Name="LockRepeatBox" PasswordChar="•" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="LockStateText" Classes="note" />
                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                            <TextBlock Text="Once unlocked, it locks again after" VerticalAlignment="Center" />
                            <NumericUpDown x:Name="LockMinutesBox" Minimum="1" Maximum="120" Increment="1" FormatString="0" Width="110" />
                            <TextBlock Text="minutes" VerticalAlignment="Center" />
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock Classes="note" Text="Everything is kept in what happened each day: started, stopped and closed by hand, settings changed, wrong passwords. Nobody stops the stream by accident: stopping and closing always ask first." />
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
