<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Playout.App.Controls"
        x:Class="Playout.App.CueEditorWindow"
        Title="Cue points"
        Width="1000" Height="660" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <StreamGeometry x:Key="IconPlay">M0,0 L11,7 L0,14 Z</StreamGeometry>
        <StreamGeometry x:Key="IconPause">M0,0 H4 V14 H0 Z M7,0 H11 V14 H7 Z</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.note">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Button.small">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.time">
            <Setter Property="FontFeatures" Value="+tnum" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="PathText" Classes="note" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </StackPanel>

        <Border DockPanel.Dock="Top" x:Name="OnAirWarning" IsVisible="False" Background="#4A3510" BorderBrush="#F5A524"
                BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
            <TextBlock TextWrapping="Wrap" Foreground="#FFD48A" FontSize="12"
                       Text="Preview comes out of the same output as Music or Cartwall, so anything you play here is heard on air. Choose a separate Preview output in Settings → Audio (e.g. the desk's PFL / cue input)." />
        </Border>

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="AutoButton" Content="Auto-detect" IsEnabled="False"
                        ToolTip.Tip="Set Cue In and Cue Out at the first and last sound, and Mix where a fade-out has died down. Intro and Outro are kept." />
                <Button x:Name="ClearAllButton" Content="Clear all" />
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="ErrorText" Foreground="{StaticResource OnAir}" FontSize="12" VerticalAlignment="Center"
                       HorizontalAlignment="Right" Margin="12,0" TextWrapping="Wrap" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" HorizontalContentAlignment="Center" IsCancel="True" />
                <Button x:Name="SaveButton" Content="Save" MinWidth="90" HorizontalContentAlignment="Center" Classes="accent" />
            </StackPanel>
        </Grid>

        <Grid RowDefinitions="150,6,48,12,Auto,16,Auto">
            <c:WaveformView x:Name="WaveZoom" Mode="Scrolling" WindowSeconds="10" Interactive="True" Cursor="Hand" />
            <c:WaveformView Grid.Row="2" x:Name="WaveFull" Mode="Overview" Interactive="True" Cursor="Hand" />

            <!-- Pre-listen transport -->
            <Grid Grid.Row="4" ColumnDefinitions="Auto,16,Auto,*">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="Back5Button" Classes="small" Content="−5 s" />
                    <Button x:Name="Back1Button" Classes="small" Content="−1 s" />
                    <Button x:Name="PlayButton" Classes="small" Width="56" ToolTip.Tip="Play / pause (Space)">
                        <PathIcon x:Name="PlayIcon" Width="13" Height="13" Data="{StaticResource IconPlay}" />
                    </Button>
                    <Button x:Name="Fwd1Button" Classes="small" Content="+1 s" />
                    <Button x:Name="Fwd5Button" Classes="small" Content="+5 s" />
                </StackPanel>
                <TextBlock Grid.Column="2" x:Name="PositionText" Classes="digits" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Classes="note" HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Right"
                           Text="Click the waveform to jump · Space play/pause · ← → 1 s (Shift 0.1 s) · Mouse wheel zooms" />
            </Grid>

            <!-- One row per marker, built in code -->
            <StackPanel Grid.Row="6" x:Name="MarkerRows" Spacing="6" />
        </Grid>
    </DockPanel>
</Window>
