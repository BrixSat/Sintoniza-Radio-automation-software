<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Playout.App.Controls"
        x:Class="Playout.App.HourMixWindow"
        Icon="/Assets/icon.ico"
        Title="Mix editor"
        Width="1280" Height="640" MinWidth="900" MinHeight="480"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.note">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Button.small">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="18">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <StackPanel Spacing="2">
                <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="EndsText" Classes="note" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="ZoomOutButton" Classes="small" Content="−" ToolTip.Tip="Zoom out (Ctrl + wheel)" />
                <Button x:Name="ZoomInButton" Classes="small" Content="+" ToolTip.Tip="Zoom in (Ctrl + wheel)" />
                <Button x:Name="ZoomAllButton" Classes="small" Content="Whole hour" />
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" x:Name="OnAirWarning" IsVisible="False" Background="#4A3510" BorderBrush="#F5A524"
                BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap" Foreground="#FFD48A" FontSize="12"
                       Text="Preview comes out of the same output as Music or Cartwall, so anything you play here is heard on air. Choose a separate Preview output in Settings → Audio (e.g. the desk's PFL / cue input)." />
        </Border>

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="PlayButton" Content="▶  Play from the cursor" Classes="accent" ToolTip.Tip="From where you clicked, through the joins, as on air (Space)" />
                <Button x:Name="StopButton" Content="■" MinWidth="44" HorizontalContentAlignment="Center" ToolTip.Tip="Stop listening" />
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="ErrorText" Foreground="{StaticResource OnAir}" FontSize="12" VerticalAlignment="Center"
                       HorizontalAlignment="Right" Margin="12,0" TextWrapping="Wrap" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" HorizontalContentAlignment="Center" IsCancel="True" />
                <Button x:Name="SaveButton" Content="Save" MinWidth="90" HorizontalContentAlignment="Center" Classes="accent" />
            </StackPanel>
        </Grid>

        <!-- The selected item: how it starts over the one before -->
        <Border DockPanel.Dock="Bottom" Background="#1A1D24" CornerRadius="6" Padding="12,10" Margin="0,10,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SelectedText" Classes="note" />
                </StackPanel>
                <StackPanel Grid.Column="1" x:Name="MovePanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Starts" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Button x:Name="Earlier1" Classes="small" Content="−1 s" ToolTip.Tip="1 second earlier" />
                    <Button x:Name="Earlier01" Classes="small" Content="−0.1" />
                    <Button x:Name="Later01" Classes="small" Content="+0.1" />
                    <Button x:Name="Later1" Classes="small" Content="+1 s" ToolTip.Tip="1 second later" />
                    <Button x:Name="AutomaticButton" Classes="small" Content="Automatic" Margin="8,0,0,0"
                            ToolTip.Tip="Back to the automatic crossfade" />
                    <Button x:Name="SegueButton" Classes="small" Content="Segue…" Margin="8,0,0,0"
                            ToolTip.Tip="The join's cue points, for every time these play (double-click the item)" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Classes="note" Margin="0,8,0,0"
                   Text="Drag an item to start it earlier, over the end of the one before: for this hour only, and the one before plays on to its end (as under a voice track). Click to put the cursor, double-click an item for its join with the one before. The wheel scrolls; Ctrl + wheel zooms. The red line is the top of the hour; ad breaks and events from the schedule are shown but don't move here." />

        <DockPanel>
            <ScrollBar DockPanel.Dock="Bottom" x:Name="Scroll" Orientation="Horizontal" Margin="0,4,0,0" />
            <c:HourMixView x:Name="Timeline" MinHeight="240" Focusable="True" />
        </DockPanel>
    </DockPanel>
</Window>
