<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>RadioPlayout</AssemblyName>
    <RootNamespace>Playout.App</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- build.sh sets the real version; a build from source is 0.0.0 and never offers updates. -->
    <Version>0.0.0</Version>
    <Product>Sintoniza Radio Broadcast system</Product>
    <AssemblyTitle>Sintoniza Radio Broadcast system</AssemblyTitle>
    <Company>César Araújo</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="System.IO.Ports" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\icon.ico" />
    <AvaloniaResource Include="Assets\schedule.ico" />
    <AvaloniaResource Include="Assets\import.ico" />
    <AvaloniaResource Include="Assets\rec.ico" />
    <EmbeddedResource Include="Assets\remote.html" LogicalName="remote.html" />
    <EmbeddedResource Include="i18n\*.json" LogicalName="i18n.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The manual's screenshots (tools/ManualShots) open the windows as the app does. -->
    <InternalsVisibleTo Include="ManualShots" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Playout.Engine\Playout.Engine.csproj" />
    <ProjectReference Include="..\Playout.Library\Playout.Library.csproj" />
  </ItemGroup>

  <Import Project="..\Bass.targets" />
</Project>
