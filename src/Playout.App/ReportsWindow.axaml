<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Playout.App.ReportsWindow"
        Icon="/Assets/icon.ico"
        Title="Reports"
        Width="860" Height="600" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="18">
        <WrapPanel DockPanel.Dock="Top" ItemSpacing="14" LineSpacing="10">
            <StackPanel>
                <TextBlock Classes="label" Text="Report" />
                <ComboBox x:Name="KindBox" Width="250" SelectedIndex="0">
                    <ComboBoxItem Content="Music played (royalties)" />
                    <ComboBoxItem Content="Music totals per song (royalties)" />
                    <ComboBoxItem Content="Adverts (proof of broadcast)" />
                    <ComboBoxItem Content="Everything (as-run log)" />
                </ComboBox>
            </StackPanel>
            <StackPanel>
                <TextBlock Classes="label" Text="From" />
                <CalendarDatePicker x:Name="FromBox" Width="150" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" />
            </StackPanel>
            <StackPanel>
                <TextBlock Classes="label" Text="To" />
                <CalendarDatePicker x:Name="ToBox" Width="150" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" />
            </StackPanel>
            <StackPanel x:Name="AdvertiserPanel" IsVisible="False">
                <TextBlock Classes="label" Text="Advertiser" />
                <ComboBox x:Name="AdvertiserBox" Width="200" />
            </StackPanel>
        </WrapPanel>

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CsvButton" Content="Save as CSV…" Classes="accent"
                        ToolTip.Tip="A spreadsheet file (Excel, LibreOffice): what collecting societies usually ask for" />
                <ComboBox x:Name="SeparatorBox" SelectedIndex="0" VerticalAlignment="Center"
                          ToolTip.Tip="Spreadsheets set up for a decimal comma (Portugal, most of Europe) open semicolon files correctly">
                    <ComboBoxItem Content="Separated by commas" />
                    <ComboBoxItem Content="Separated by semicolons" />
                </ComboBox>
                <Button x:Name="HtmlButton" Content="Save as a page to print…"
                        ToolTip.Tip="Opens in a web browser: print it or save it as PDF (e.g. for an advertiser)" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="CloseButton" Content="Close" MinWidth="90" HorizontalContentAlignment="Center" IsCancel="True" />
        </Grid>

        <TextBlock DockPanel.Dock="Bottom" Classes="note" Margin="0,8,0,0"
                   Text="Made from the as-run log: everything that went on air from this computer (playlist, scheduled events, ad breaks and carts). Album, composer, label and ISRC come from the files' tags." />

        <DockPanel Margin="0,14,0,0">
            <TextBlock DockPanel.Dock="Top" x:Name="SummaryText" FontWeight="SemiBold" Margin="0,0,0,6" />
            <Border Background="#13161C" CornerRadius="6" Padding="2">
                <ScrollViewer HorizontalScrollBarVisibility="Auto">
                    <TextBlock x:Name="PreviewText" FontFamily="Consolas,Menlo,DejaVu Sans Mono,Liberation Mono,monospace" FontSize="11" Margin="8" />
                </ScrollViewer>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
