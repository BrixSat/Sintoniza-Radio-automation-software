<app:PageWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:Playout.App"
        x:Class="Playout.App.ImportWindow"
        Icon="/Assets/import.ico"
        Title="Sintoniza Import"
        Width="1000" Height="800" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <app:PageWindow.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.tag">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.tag > TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="0.8" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </app:PageWindow.Styles>

    <DockPanel Margin="16">
        <!-- What to import -->
        <Border DockPanel.Dock="Top" Classes="panel" Padding="16">
            <StackPanel Spacing="14">
                <TextBlock x:Name="LibraryText" Classes="note" />
                <StackPanel>
                    <TextBlock Classes="label" Text="Folder to import (with the folders inside it)" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="FolderBox" PlaceholderText="Choose a folder, e.g. D:\Music" />
                        <Button Grid.Column="1" x:Name="ChooseButton" Content="Choose…" Margin="6,0,0,0" />
                    </Grid>
                </StackPanel>
                <Grid ColumnDefinitions="*,16,*,16,*,16,1.3*">
                    <StackPanel>
                        <TextBlock Classes="label" Text="Into the category" />
                        <TextBox x:Name="NameBox" PlaceholderText="e.g. Music" MaxLength="100" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Classes="label" Text="Under" />
                        <ComboBox x:Name="ParentBox" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Classes="label" Text="Kind (new categories)" />
                        <ComboBox x:Name="KindBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <ComboBoxItem Content="Music" />
                            <ComboBoxItem Content="Jingle (IDs, sweepers)" />
                            <ComboBoxItem Content="Commercial" />
                            <ComboBoxItem Content="Other (promos, talk…)" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Classes="label" Text="Folders inside become sub-categories" />
                        <ComboBox x:Name="LevelsBox" HorizontalAlignment="Stretch" SelectedIndex="1">
                            <ComboBoxItem Content="No: all in this category" />
                            <ComboBoxItem Content="1 level (Music › 80s)" />
                            <ComboBoxItem Content="2 levels (› 80s › Rock)" />
                            <ComboBoxItem Content="3 levels" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <StackPanel>
                    <TextBlock Classes="label" Text="Songs already in another category" />
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <RadioButton x:Name="AlsoInRadio" GroupName="how" IsChecked="True" Content="Keep it, and add this one too" />
                        <RadioButton x:Name="ReplaceRadio" GroupName="how" Content="Move them to this one" />
                        <RadioButton x:Name="LeaveRadio" GroupName="how" Content="Leave them as they are" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="PreviewButton" Content="Preview import" Classes="accent" IsDefault="True" MinWidth="110" HorizontalContentAlignment="Center" />
                    <TextBlock x:Name="PreviewNote" Classes="note" VerticalAlignment="Center"
                               Text="Shows what the import will do. Nothing is changed until you click Import." />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Import, progress -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,12,0,0">
            <StackPanel VerticalAlignment="Center" Spacing="6" Margin="0,0,12,0">
                <TextBlock x:Name="StatusText" Classes="note" TextWrapping="Wrap" />
                <ProgressBar x:Name="Progress" IsVisible="False" Height="6" MinHeight="6" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="ImportButton" Content="Import" Classes="accent" IsEnabled="False" MinWidth="110"
                    HorizontalContentAlignment="Center" />
            <Button Grid.Column="2" x:Name="StopButton" Content="Stop" IsVisible="False" MinWidth="90" Margin="8,0,0,0"
                    HorizontalContentAlignment="Center" />
            <Button Grid.Column="3" x:Name="CloseButton" Content="Close" MinWidth="90" Margin="8,0,0,0" HorizontalContentAlignment="Center" />
        </Grid>

        <!-- The preview: the categories that will be made, and what goes in each -->
        <Border Classes="panel" Padding="12" Margin="0,12,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,90,130,190" Margin="8,0,8,6">
                    <TextBlock Classes="caption" Text="CATEGORY" />
                    <TextBlock Grid.Column="1" Classes="caption" Text="FILES" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Classes="caption" Text="IN LIBRARY" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Classes="caption" Text="IN ANOTHER CATEGORY" HorizontalAlignment="Right" />
                </Grid>
                <TextBlock DockPanel.Dock="Bottom" x:Name="TotalText" Classes="note" Margin="8,8,0,0" />
                <Panel>
                    <ListBox x:Name="PlanList" Background="Transparent">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="8,4" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="app:ImportRow">
                                <Grid ColumnDefinitions="*,90,130,190" ToolTip.Tip="{Binding Folder}">
                                    <DockPanel Margin="{Binding Indent}">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border DockPanel.Dock="Left" Classes="tag" Margin="8,0" Background="{Binding TagBrush}">
                                            <TextBlock Text="{Binding Tag}" />
                                        </Border>
                                        <TextBlock Classes="muted" Text="{Binding FolderName}" FontSize="11" VerticalAlignment="Center"
                                                   TextTrimming="{x:Static TextTrimming.PrefixCharacterEllipsis}" Margin="0,0,12,0" />
                                    </DockPanel>
                                    <TextBlock Grid.Column="1" Classes="digits" Text="{Binding Files}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Classes="muted digits" Text="{Binding InLibrary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Classes="muted digits" Text="{Binding InOther}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" Classes="muted" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="24"
                               Text="Choose a folder and the category, then click Preview import to see the categories that will be made and the songs in each." />
                </Panel>
            </DockPanel>
        </Border>
    </DockPanel>
</app:PageWindow>
