<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:Playout.App"
        x:Class="Playout.App.CertificateWindow"
        x:DataType="app:CertificateWindow"
        Icon="/Assets/schedule.ico"
        Title="Broadcast certificate"
        Width="940" Height="680" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,10">
            <TextBlock x:Name="ClientText" FontSize="17" FontWeight="SemiBold" />
            <WrapPanel ItemSpacing="8" LineSpacing="8">
                <StackPanel>
                    <TextBlock Classes="label" Text="Campaign" />
                    <ComboBox x:Name="CampaignBox" MinWidth="220" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Classes="label" Text="From" />
                    <CalendarDatePicker x:Name="FromBox" Width="150" SelectedDateFormat="Short" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Classes="label" Text="To" />
                    <CalendarDatePicker x:Name="ToBox" Width="150" SelectedDateFormat="Short" />
                </StackPanel>
                <Button x:Name="LastMonthButton" Content="Last month" VerticalAlignment="Bottom" />
                <Button x:Name="ThisMonthButton" Content="This month" VerticalAlignment="Bottom" />
            </WrapPanel>
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,10,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Classes="label" Text="Sintoniza Rec's recordings:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" x:Name="RecordingsText" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" x:Name="RecordingsButton" Content="Change…" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                    <Button x:Name="ListenButton" Content="▶ Listen" IsEnabled="False"
                            ToolTip.Tip="The recording of the moment the selected advert went on air" />
                    <Button x:Name="StopButton" Content="■" IsEnabled="False" />
                    <Button x:Name="SaveAudioButton" Content="Save its audio…" IsEnabled="False"
                            ToolTip.Tip="The selected advert as it went on air, from the recording: to send to the client" />
                    <TextBlock x:Name="AudioText" Classes="note" VerticalAlignment="Center" MaxWidth="320" />
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CsvButton" Content="CSV…" />
                    <Button x:Name="HtmlButton" Content="Certificate to print…" Classes="accent" />
                    <Button x:Name="CloseButton" Content="Close" IsCancel="True" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <ListBox x:Name="LineList" Background="#13161C">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="app:CertificateRow">
                    <Grid ColumnDefinitions="100,64,84,60,*,150">
                        <TextBlock Text="{Binding Date}" />
                        <TextBlock Grid.Column="1" Text="{Binding Booked}" Foreground="{StaticResource TextMuted}" />
                        <TextBlock Grid.Column="2" Text="{Binding OnAir}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="{Binding Duration}" Foreground="{StaticResource TextMuted}" />
                        <TextBlock Grid.Column="4" Text="{Binding What}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="5" Text="{Binding Status}" Foreground="{Binding Brush}" FontWeight="SemiBold" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
