<Project Sdk="Microsoft.NET.Sdk">
  <!-- Sintoniza Rec: its own program (process, executable, icon): records the station's sound with Playout.App's recorder. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>..\Playout.App\app.manifest</ApplicationManifest>
    <AssemblyName>SintonizaRec</AssemblyName>
    <RootNamespace>Playout.Rec</RootNamespace>
    <ApplicationIcon>..\Playout.App\Assets\rec.ico</ApplicationIcon>
    <!-- build.sh sets the real version. -->
    <Version>0.0.0</Version>
    <Product>Sintoniza</Product>
    <AssemblyTitle>Sintoniza Rec</AssemblyTitle>
    <Company>César Araújo</Company>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Playout.App\Playout.App.csproj" />
  </ItemGroup>
  <Import Project="..\Bass.targets" />
</Project>
