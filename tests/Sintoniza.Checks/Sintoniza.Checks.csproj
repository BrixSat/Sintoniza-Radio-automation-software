<Project Sdk="Microsoft.NET.Sdk">
  <!-- Sintoniza's checks before a release (scripts/check.sh runs them): headless, no sound, a library of their own. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Playout.App\Playout.App.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
  </ItemGroup>
  <Import Project="..\..\src\Bass.targets" />
</Project>
